# Copy file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Lấy ở Supabase Dashboard → Project Settings → API Keys / Data API.

# Project URL, dạng https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...) hoặc legacy "anon" key.
# Key này được phép nằm trong app vì dữ liệu đã được bảo vệ bằng RLS.
# TUYỆT ĐỐI KHÔNG dùng Secret key / service_role key ở đây.
VITE_SUPABASE_PUBLISHABLE_KEY=
